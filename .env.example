# Copy this file to .env. Choose http (LAN bridge) OR mqtt (existing AWS feed).
PORT=3000
HOST=127.0.0.1
SENSOR_SOURCE=http
SENSOR_API_TOKEN=
SENSOR_STALE_SECONDS=60
# Separate, locally generated server-only secret for signing Express sessions.
SESSION_SECRET=
# MongoDB Atlas connection string. Uses the iwos_database database.
MONGODB_URI=
# Original sensor timestamps have no offset. Match the Raspberry Pi's timezone.
# South Africa = +02:00; a Pi configured to UTC = +00:00.
SENSOR_TIMEZONE_OFFSET=+02:00

# MQTT mode only. Use your weather station's broker hostname (no https://).
MQTT_HOST=
MQTT_PORT=8883
MQTT_TOPIC=iwos/weather
# Must differ from the weather station's iwos-lead-vehicle-01 client ID.
MQTT_CLIENT_ID=iwos-dashboard-01
MQTT_CA_PATH=certs/AmazonRootCA1.pem
MQTT_CERT_PATH=certs/dashboard-certificate.pem.crt
MQTT_KEY_PATH=certs/dashboard-private.pem.key


//the certificates are generated from the AWS IoT console.
/certs