<link rel="stylesheet" href="/css.css" />
<link rel="stylesheet" href="/integration.css" />

<% 
  const userObj = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : ((typeof user !== 'undefined' && user) ? user : null);
  const displayName = userObj ? (userObj.fullName || userObj.name || userObj.email) : null;
  const avatarLetter = displayName ? displayName.charAt(0).toUpperCase() : '♙';
  const vehicleName = userObj ? (userObj.vehicleNickname || 'IWOS-07') : 'IWOS-07';
  const token = typeof csrfToken !== 'undefined' ? csrfToken : '';
  const currentTheme = typeof themePreference !== 'undefined' ? themePreference : 'dark';
%>

<header class="iwos-topbar">
  <button type="button" id="menuToggle" class="nav-btn" aria-label="Open Navigation">
    <span class="hamburger-line"></span>
    <span class="hamburger-line"></span>
    <span class="hamburger-line"></span>
  </button>

  <div class="topbar-title-group">
    <div class="brand-badge-row">
      <img class="brand-logo" src="/iwos-logo.svg" alt="IWOS Field Telemetry">
    </div>
    <h1 class="topbar-title">
      <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Telemetry Dashboard' %>
    </h1>
  </div>
  
  <div class="topbar-actions">
    <details class="profile-menu">
      <summary class="profile-trigger" aria-label="Open profile menu">
        <% if (userObj && userObj.profilePictureUrl) { %>
          <img class="profile-avatar profile-avatar-image" src="<%= userObj.profilePictureUrl %>" alt="">
        <% } else { %>
          <span class="profile-avatar"><%= avatarLetter %></span>
        <% } %>
        <span class="profile-trigger-name"><%= displayName || 'Guest' %></span>
        <span class="profile-chevron" aria-hidden="true">⌄</span>
      </summary>
      <div class="profile-dropdown">
        <% if (userObj) { %>
          <div class="profile-identity">
            <strong><%= displayName %></strong>
            <span><%= userObj.email %></span>
          </div>
          <a href="/settings" class="profile-menu-link">Personalization &amp; Settings</a>
        <% } else { %>
          <div class="profile-identity">
            <strong>Guest</strong>
            <span>Browsing public telemetry</span>
          </div>
          <a href="/signin" class="profile-menu-link">Sign In</a>
          <a href="/register" class="profile-menu-link">Register</a>
        <% } %>
        
        <div class="theme-switcher">
          <span>Appearance</span>
          <button type="button" class="theme-toggle" data-theme-toggle data-csrf="<%= token %>" aria-pressed="<%= currentTheme === 'light' ? 'true' : 'false' %>">
            <span class="theme-toggle-label"><%= currentTheme === 'light' ? 'Light Mode' : 'Dark Mode' %></span>
            <span class="theme-toggle-track" aria-hidden="true"><span></span></span>
          </button>
          <span class="theme-error" data-theme-error role="status" hidden></span>
        </div>
        
        <% if (userObj) { %>
          <form method="post" action="/logout">
            <input type="hidden" name="_csrf" value="<%= token %>">
            <button type="submit" class="profile-menu-link profile-logout">Sign Out</button>
          </form>
        <% } %>
      </div>
    </details>
    <% if (!userObj) { %><a class="auth-nav-link auth-nav-primary" href="/signin">Sign In</a><% } %>
  </div>
</header>

<div id="drawerOverlay" class="drawer-overlay"></div>

<aside id="sidebarDrawer" class="sidebar-drawer">
  <div class="drawer-header">
    <div class="brand-badge-row">
      <img class="brand-logo" src="/iwos-logo.svg" alt="IWOS Field Telemetry">
    </div>
    <button type="button" id="closeDrawer" class="close-btn" aria-label="Close Navigation">&times;</button>
  </div>

  <nav class="sidebar-nav" aria-label="Main Navigation">
    <!-- Live Status / Dashboard -->
    <a 
      href="/dashboard" 
      class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'dashboard') ? 'active' : '' %>"
    >
      <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor">
        <path d="M3 3h7v7H3V3zm11 0h7v7h-7V3zm-11 11h7v7H3v-7zm11 0h7v7h-7v-7z"/>
      </svg>
      <span>Live Status</span>
    </a>

    <!-- Route Setup Navigation -->
    <a 
      href="/route-setup" 
      class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'route-setup') ? 'active' : '' %>"
    >
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="3 11 22 2 13 21 11 13 3 11"/>
      </svg>
      <span>Route Setup</span>
    </a>

    <!-- Sync & Logs -->
    <a 
      href="/sync-sessions" 
      class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'sync') ? 'active' : '' %>"
    >
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.3"/>
      </svg>
      <span>Sync &amp; Logs</span>
    </a>

    <!-- AI Optimisation Anchor -->
    <a href="/dashboard#optimization-section" class="nav-link">
      <span class="nav-icon">✧</span>
      <span>AI Optimisation</span>
    </a>

    <% if (userObj) { %>
      <a href="/settings" class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'settings') ? 'active' : '' %>">
        <span class="nav-icon">⚙</span>
        <span>Personalization</span>
      </a>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= token %>">
        <button type="submit" class="nav-link nav-signout">
          <span class="nav-icon">↪</span>
          <span>Sign Out</span>
        </button>
      </form>
    <% } else { %>
      <a href="/signin" class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'signin') ? 'active' : '' %>">
        <span class="nav-icon">↪</span>
        <span>Sign In</span>
      </a>
      <a href="/register" class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'register') ? 'active' : '' %>">
        <span class="nav-icon">＋</span>
        <span>Create Account</span>
      </a>
    <% } %>
  </nav>

  <div class="sidebar-footer-card">
    <div class="card-top-row">
      <div class="vehicle-identity">
        <strong class="vehicle-code"><%= vehicleName %></strong>
        <span class="lead-pill">LEAD</span>
      </div>
      <div class="battery-metric">
        <svg class="battery-icon" viewBox="0 0 24 24" fill="none" stroke="#00e599" stroke-width="2">
          <rect x="2" y="7" width="16" height="10" rx="2" ry="2"></rect>
          <line x1="22" y1="11" x2="22" y2="13"></line>
        </svg>
        <span class="battery-value" data-battery><%= typeof batteryLevel !== 'undefined' ? batteryLevel + '%' : '—' %></span>
      </div>
    </div>
    
    <div class="status-divider"></div>

    <div class="card-bottom-row">
      <span class="sensor-dot"></span>
      <span class="status-label" data-feed-state>Waiting</span>
    </div>
  </div>
</aside>